{
  "name": "@hermes/chrome-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server for the Hermes Chrome bridge",
  "type": "module",
  "bin": {
    "hermes-chrome-bridge": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepare": "npm run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}